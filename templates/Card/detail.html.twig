{# templates/Default/home.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Erna Magnus Collection{% endblock %}

{% block body %}
    <h1><a href="{{ path('card-index') }}#{{ cardNames[cardIdx] }}">Cards A-Z</a></h1>
    {% block content %}
    {% set cardIdxPrev = cardIdx > 0 ? cardIdx - 1 : 0 %}
    {% set cardIdxNext = cardIdx < cardNames|length - 1 ? cardIdx + 1 : cardNames|length - 1 %}
    <nav aria-label="Page navigation example">
        <ul class="pagination justify-content-center">
            <li class="page-item{% if cardIdx == 0 %} disabled{% endif %}">
                <a class="page-link" href="{{ path('card-detail', {'card': cardNames[cardIdxPrev]}) }}" tabindex="-1">Previous</a>
            </li>
            <li class="page-item"><a class="page-link" href="{{ path('card-detail', {'card': cardNames[0]}) }}">1</a></li>
            {% if cardNames|length > 3 and cardIdx > 1 %}
            <li class="page-item disabled" aria-disabled="true">
                <span class="page-link">&hellip;</span>
            </li>
            {% endif %}
            {% if cardIdx > 0 and cardIdx < cardIdxNext %}
            <li class="page-item disabled" aria-disabled="true">
                <a class="page-link" href="{{ path('card-detail', {'card': cardNames[cardIdx]}) }}" tabindex="-1">{{ cardIdx + 1 }}</a>
            </li>
            {% endif %}
            {% if cardIdxNext < cardNames|length - 1 %}
            <li class="page-item disabled" aria-disabled="true">
                <span class="page-link">&hellip;</span>
            </li>
            {% endif %}
            <li class="page-item"><a class="page-link" href="{{ path('card-detail', {'card': cardNames[cardNames|length - 1]}) }}">{{ cardNames|length }}</a></li>
            <li class="page-item{% if cardIdx == cardNames|length - 1 %} disabled{% endif %}">
                <a class="page-link" href="{{ path('card-detail', {'card': cardNames[cardIdxNext]}) }}" tabindex="-1">Next</a>
            </li>
        </ul>
    </nav>
    <div class="container-fluid">
        <div class="row">
            <div class="col col-md-6 col-lg-8">
                <img src="{{ asset('a-z/' ~ cardNames[cardIdx] ~ '.jpg') }}" class="img-fluid" alt="{{ cardNames[cardIdx] }}">
            </div>
            <div class="col col-md-6 col-lg-4">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#display">Display</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#normalized">Normalized</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#raw">Raw</a>
            </li>
            </ul>

            <!-- Tab panes -->
            <div class="tab-content">
            <div class="tab-pane container active" id="display">
                {% for type, flashes in app.session.flashbag.all %}
                    {% for flash in flashes %}
                        <div class="alert alert-{% if type == 'error' %}danger{% else %}{{ type }}{% endif %}" role="alert">
                            {{ flash }}
                        </div>
                    {% endfor %}
                {% endfor %}
                <h3>{{ card.fullname }} <small class="text-body-secondary">{{ card.title }}{% if card.gender is not empty and card.gender=='F' %} ♀{% endif %}</small></h3>
                {% if card.birth is not null %}
                    <div>* {{ card.birth.place }}{% if card.birth.date is not empty and card.birth.place is not null %}, {% endif %}{{ card.birth.date }}</div>
                {% endif %}
                {% if card.death is not null %}
                    <div>✡︎ {{ card.death.place }}{% if card.death.date is not empty and card.death.place is not null %}, {% endif %}{{ card.death.date }}</div>
                {% endif %}
                {% if card.religion is not null %}
                    <div>{{ card.religion }}</div>
                {% endif %}
                {% if card.fieldOfActivity is not empty %}
                    <div class="text-end">{{ card.fieldOfActivity }}</div>
                {% endif %}
                {% if card.familyRelations is not empty %}
                    <ul class="mb-0">
                    {% for relation in card.familyRelations %}
                        <li>{{ relation.role }}: {{ relation.name }}</li>
                    {% endfor %}
                    </ul>
                {% endif %}
                {% if card.profession is not null %}
                    <div><b>{{ card.profession }}</b></div>
                {% endif %}
                {% if card.details is not empty %}
                    <ul class="mb-0">
                    {% for line in card.details %}
                        <li>{{ line }}</li>
                    {% endfor %}
                    </ul>
                {% endif %}
                {% if card.publications is not empty %}
                <div><b>Schriften:</b></div>
                    <ul class="mb-0">
                    {% for line in card.publications %}
                        <li>{{ line }}</li>
                    {% endfor %}
                    </ul>
                {% endif %}
                {% if card.literature is not empty %}
                <div><b>Lit.:</b></div>
                    <ul class="mb-0">
                    {% for line in card.literature %}
                        <li>{{ line }}</li>
                    {% endfor %}
                    </ul>
                {% endif %}
                <a href="{{ path('card-edit', {'card': cardNames[cardIdx]}) }}" class="btn btn-primary mt-3">Edit</a>
                {#
                <code><pre>{{ card|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}
                </pre></code>
                #}
            </div>
            <div class="tab-pane container fade" id="normalized">
                <code><pre>{{ cardData['normalized']|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}
                </pre>
                </code>
            </div>
            <div class="tab-pane container fade" id="raw">
                <code><pre>{{ cardData['orig']|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}
                </pre>
                </code>
            </div>
            </div><!-- .tab-content -->
            </div>
        </div><!-- .row -->
    </div><!-- .container -->
    {% endblock %}
{% endblock %}
